{
  "name": "makululinux-game-studio",
  "version": "1.0.0",
  "description": "Next-Gen 3D Game Editor built on PlayCanvas Engine with Native AI Studio Copilot",
  "author": "MakuluLinux Team <info@makululinux.org>",
  "homepage": "https://www.makululinux.org",
  "desktopName": "makululinux-game-studio",
  "private": true,
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "electron": "electron electron.cjs",
    "studio": "electron electron.cjs",
    "dist:dir": "vite build && electron-builder --dir",
    "dist:linux": "vite build && electron-builder --linux AppImage deb",
    "audit:capabilities": "node scripts/capability-audit.js",
    "audit:capabilities:check": "node scripts/capability-audit.js --check"
  },
  "dependencies": {
    "playcanvas": "^2.23.3"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.4.0",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "org.makululinux.gamestudio",
    "productName": "MakuluLinux Game Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "preload.cjs",
      "desktop-security.cjs",
      "package.json",
      "public/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Development;Game",
      "icon": "public/icon.png"
    }
  }
}
